{
  "$defs": {
    "ClaimStatus": {
      "description": "Protocol-relative status labels used by ECPT, BIT, TRC, SQOT, and ALT.",
      "enum": [
        "rejected",
        "expired",
        "diagnostic",
        "relaxed",
        "risk-provisional",
        "speculative",
        "provisional",
        "partial",
        "settled"
      ],
      "title": "ClaimStatus",
      "type": "string"
    },
    "CoordinateKind": {
      "enum": [
        "benefit",
        "burden",
        "residual",
        "tolerance",
        "resource",
        "metadata"
      ],
      "title": "CoordinateKind",
      "type": "string"
    },
    "EvidenceStatus": {
      "enum": [
        "verified",
        "declared",
        "unknown"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "Ledger": {
      "description": "A finite typed ledger with explicit coordinate kinds.",
      "properties": {
        "coordinates": {
          "additionalProperties": {
            "$ref": "#/$defs/LedgerCoordinate"
          },
          "title": "Coordinates",
          "type": "object"
        }
      },
      "title": "Ledger",
      "type": "object"
    },
    "LedgerCoordinate": {
      "description": "One typed coordinate in a finite certificate ledger.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "evidence_status": {
          "$ref": "#/$defs/EvidenceStatus",
          "default": "declared"
        },
        "kind": {
          "$ref": "#/$defs/CoordinateKind",
          "default": "burden"
        },
        "known": {
          "default": true,
          "title": "Known",
          "type": "boolean"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "default": "dimensionless",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "LedgerCoordinate",
      "type": "object"
    }
  },
  "description": "Accepted or rejected satisfaction-flux ledger row.",
  "properties": {
    "accepted": {
      "default": false,
      "title": "Accepted",
      "type": "boolean"
    },
    "amount": {
      "default": 0.0,
      "title": "Amount",
      "type": "number"
    },
    "authority_refs": {
      "items": {
        "type": "string"
      },
      "title": "Authority Refs",
      "type": "array"
    },
    "certificate_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Certificate Id"
    },
    "consent_refs": {
      "items": {
        "type": "string"
      },
      "title": "Consent Refs",
      "type": "array"
    },
    "effective_amount": {
      "default": 0.0,
      "title": "Effective Amount",
      "type": "number"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "flux_id": {
      "default": "",
      "title": "Flux Id",
      "type": "string"
    },
    "latency": {
      "default": 0.0,
      "title": "Latency",
      "type": "number"
    },
    "loss_upper_bound": {
      "default": 0.0,
      "title": "Loss Upper Bound",
      "type": "number"
    },
    "observed_satisfaction_post": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Observed Satisfaction Post",
      "type": "object"
    },
    "predicted_satisfaction_post": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Predicted Satisfaction Post",
      "type": "object"
    },
    "predicted_satisfaction_pre": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Predicted Satisfaction Pre",
      "type": "object"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    },
    "record_id": {
      "default": "",
      "title": "Record Id",
      "type": "string"
    },
    "refusal_refs": {
      "items": {
        "type": "string"
      },
      "title": "Refusal Refs",
      "type": "array"
    },
    "residual_ledger": {
      "$ref": "#/$defs/Ledger"
    },
    "resource_type": {
      "default": "",
      "title": "Resource Type",
      "type": "string"
    },
    "settled": {
      "default": false,
      "title": "Settled",
      "type": "boolean"
    },
    "slot": {
      "default": "finite",
      "title": "Slot",
      "type": "string"
    },
    "source_cell_id": {
      "default": "",
      "title": "Source Cell Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ClaimStatus",
      "default": "provisional"
    },
    "target_cell_id": {
      "default": "",
      "title": "Target Cell Id",
      "type": "string"
    },
    "trace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace Id"
    },
    "unit": {
      "default": "dimensionless",
      "title": "Unit",
      "type": "string"
    },
    "unit_family": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit Family"
    }
  },
  "title": "SatisfactionFluxRecord",
  "type": "object"
}
