{
  "$defs": {
    "AccelerationMeasurementMetrics": {
      "description": "Predeclared resource-matched measurements for an acceleration claim.",
      "properties": {
        "accepted": {
          "default": false,
          "title": "Accepted",
          "type": "boolean"
        },
        "certified_capital_gain": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Certified Capital Gain"
        },
        "error_correlation": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Correlation"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "fixed_horizon": {
          "default": false,
          "title": "Fixed Horizon",
          "type": "boolean"
        },
        "receiver_reuse": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Receiver Reuse"
        },
        "residual_half_life": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Residual Half Life"
        },
        "resource_cost": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Cost"
        },
        "stopping_rule_ref": {
          "default": "",
          "title": "Stopping Rule Ref",
          "type": "string"
        },
        "time_to_verified": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time To Verified"
        },
        "verification_yield": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification Yield"
        }
      },
      "title": "AccelerationMeasurementMetrics",
      "type": "object"
    },
    "AccelerationMetricComparison": {
      "description": "Direction-aware comparison of one predeclared acceleration metric.",
      "properties": {
        "baseline_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Value"
        },
        "candidate_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Value"
        },
        "direction": {
          "title": "Direction",
          "type": "string"
        },
        "finite": {
          "default": false,
          "title": "Finite",
          "type": "boolean"
        },
        "improved": {
          "default": false,
          "title": "Improved",
          "type": "boolean"
        },
        "metric_name": {
          "title": "Metric Name",
          "type": "string"
        },
        "non_regressed": {
          "default": false,
          "title": "Non Regressed",
          "type": "boolean"
        },
        "signed_improvement": {
          "default": 0.0,
          "title": "Signed Improvement",
          "type": "number"
        },
        "tolerance": {
          "default": 0.0,
          "title": "Tolerance",
          "type": "number"
        }
      },
      "required": [
        "metric_name",
        "direction"
      ],
      "title": "AccelerationMetricComparison",
      "type": "object"
    },
    "CoordinateKind": {
      "enum": [
        "benefit",
        "burden",
        "residual",
        "tolerance",
        "resource",
        "metadata"
      ],
      "title": "CoordinateKind",
      "type": "string"
    },
    "EvidenceStatus": {
      "enum": [
        "verified",
        "declared",
        "unknown"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "Ledger": {
      "description": "A finite typed ledger with explicit coordinate kinds.",
      "properties": {
        "coordinates": {
          "additionalProperties": {
            "$ref": "#/$defs/LedgerCoordinate"
          },
          "title": "Coordinates",
          "type": "object"
        }
      },
      "title": "Ledger",
      "type": "object"
    },
    "LedgerCoordinate": {
      "description": "One typed coordinate in a finite certificate ledger.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "evidence_status": {
          "$ref": "#/$defs/EvidenceStatus",
          "default": "declared"
        },
        "kind": {
          "$ref": "#/$defs/CoordinateKind",
          "default": "burden"
        },
        "known": {
          "default": true,
          "title": "Known",
          "type": "boolean"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "default": "dimensionless",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "LedgerCoordinate",
      "type": "object"
    }
  },
  "description": "Finite protocol-relative acceleration certificate against a baseline.",
  "properties": {
    "acceleration_metric_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Acceleration Metric Reasons",
      "type": "array"
    },
    "acceleration_metrics": {
      "$ref": "#/$defs/AccelerationMeasurementMetrics"
    },
    "acceleration_metrics_certified": {
      "default": false,
      "title": "Acceleration Metrics Certified",
      "type": "boolean"
    },
    "accepted": {
      "default": false,
      "title": "Accepted",
      "type": "boolean"
    },
    "baseline_run_id": {
      "title": "Baseline Run Id",
      "type": "string"
    },
    "candidate_run_id": {
      "title": "Candidate Run Id",
      "type": "string"
    },
    "certificate_id": {
      "title": "Certificate Id",
      "type": "string"
    },
    "false_liquidity_bounded": {
      "default": false,
      "title": "False Liquidity Bounded",
      "type": "boolean"
    },
    "finite_checks_passed": {
      "default": false,
      "title": "Finite Checks Passed",
      "type": "boolean"
    },
    "hitting_time_gain_lower_bound": {
      "default": 0.0,
      "title": "Hitting Time Gain Lower Bound",
      "type": "number"
    },
    "metric_comparisons": {
      "items": {
        "$ref": "#/$defs/AccelerationMetricComparison"
      },
      "title": "Metric Comparisons",
      "type": "array"
    },
    "operationally_usable": {
      "default": false,
      "title": "Operationally Usable",
      "type": "boolean"
    },
    "psi_distance_reduction_lower_bound": {
      "default": 0.0,
      "title": "Psi Distance Reduction Lower Bound",
      "type": "number"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    },
    "residual_external_obligations": {
      "items": {
        "type": "string"
      },
      "title": "Residual External Obligations",
      "type": "array"
    },
    "residual_ledger": {
      "$ref": "#/$defs/Ledger"
    },
    "resource_envelope_matched": {
      "default": false,
      "title": "Resource Envelope Matched",
      "type": "boolean"
    },
    "resource_matched": {
      "default": false,
      "title": "Resource Matched",
      "type": "boolean"
    },
    "salience_non_obstructed": {
      "default": false,
      "title": "Salience Non Obstructed",
      "type": "boolean"
    },
    "score_gain_lower_bound": {
      "default": 0.0,
      "title": "Score Gain Lower Bound",
      "type": "number"
    },
    "settled": {
      "default": false,
      "title": "Settled",
      "type": "boolean"
    },
    "tau_baseline": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tau Baseline"
    },
    "tau_candidate": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tau Candidate"
    },
    "threshold": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Threshold",
      "type": "object"
    },
    "verification_backlog_bounded": {
      "default": false,
      "title": "Verification Backlog Bounded",
      "type": "boolean"
    }
  },
  "required": [
    "certificate_id",
    "baseline_run_id",
    "candidate_run_id"
  ],
  "title": "AccelerationCertificate",
  "type": "object"
}
